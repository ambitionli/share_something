# --- Application ---
# Human-readable app title (OpenAPI / FastAPI metadata)
APP_NAME=ShareSomething

# Set true only for local debugging (never in production)
DEBUG=false

# API route prefix for versioned REST handlers (must match nginx /api proxy)
API_V1_PREFIX=/api/v1

# --- PostgreSQL (async + sync URLs for SQLAlchemy / Alembic) ---
# Docker Compose: use hostnames `postgres` and port 5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/share_something
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres@postgres:5432/share_something

# --- Redis ---
# Docker Compose: redis service on port 6379
REDIS_URL=redis://redis:6379/0

# --- JWT / auth ---
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- MinIO (S3-compatible storage) ---
# Docker Compose: minio service — API port 9000 inside the network
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=share-something
# true if using HTTPS to MinIO (usually false on internal Docker network)
MINIO_SECURE=false

# --- SMS (optional; leave empty if unused) ---
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=

# --- WeChat (optional) ---
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# --- Admin web (Vite build-time; empty = same origin behind reverse proxy) ---
# Local dev against Docker backend: http://localhost:8000
# Production Docker build: leave empty
# VITE_API_BASE_URL=
