<view class="page">
  <view class="field">
    <view class="label">联系人</view>
    <input class="input" value="{{name}}" placeholder="姓名" bindinput="onName" />
  </view>
  <view class="field">
    <view class="label">手机号</view>
    <input class="input" type="number" maxlength="11" value="{{phone}}" placeholder="11 位手机号" bindinput="onPhone" />
  </view>
  <view class="field">
    <view class="label">省市区</view>
    <input class="input" value="{{region}}" placeholder="如：北京市 朝阳区" bindinput="onRegion" />
  </view>
  <view class="field">
    <view class="label">详细地址</view>
    <textarea class="ta" value="{{detail}}" placeholder="街道门牌" bindinput="onDetail" />
  </view>
  <label class="row">
    <text>设为默认</text>
    <switch checked="{{isDefault}}" bindchange="onDefault" />
  </label>

  <button type="primary" bindtap="save">保存</button>
</view>
