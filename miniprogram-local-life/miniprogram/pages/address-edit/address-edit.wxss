.page {
  padding: 24rpx;
}

.field {
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}

.label {
  font-weight: 600;
  margin-bottom: 12rpx;
}

.input {
  width: 100%;
  padding: 12rpx 0;
}

.ta {
  width: 100%;
  min-height: 120rpx;
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 16rpx;
  box-sizing: border-box;
}

.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}

button {
  border-radius: 999rpx;
}
