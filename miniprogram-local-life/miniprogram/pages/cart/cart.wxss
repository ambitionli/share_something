.page {
  padding: 24rpx;
  padding-bottom: 48rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.mname {
  font-size: 32rpx;
  font-weight: 700;
}

.list {
  margin-bottom: 20rpx;
}

.line {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 12rpx;
}

.pname {
  font-size: 28rpx;
  font-weight: 600;
}

.sub {
  color: #888;
  font-size: 24rpx;
  margin-top: 6rpx;
}

.stepper {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.stepper .btn {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  border-radius: 8rpx;
  background: #f5f5f5;
}

.stepper .num {
  min-width: 40rpx;
  text-align: center;
}

.row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12rpx;
  color: #555;
}

.row.strong {
  font-weight: 700;
  font-size: 30rpx;
}

.price {
  color: #e64340;
}

.label {
  margin-bottom: 12rpx;
  font-weight: 600;
}

.ta {
  width: 100%;
  min-height: 120rpx;
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 16rpx;
  box-sizing: border-box;
}

.pay {
  border-radius: 999rpx;
  margin-top: 12rpx;
}

.empty {
  text-align: center;
  color: #888;
  padding: 40rpx 0;
}
