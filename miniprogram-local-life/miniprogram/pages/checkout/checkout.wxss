.page {
  padding: 24rpx;
  padding-bottom: 48rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.row-title {
  font-weight: 700;
  margin-bottom: 12rpx;
}

.muted {
  color: #888;
  font-size: 24rpx;
  margin-top: 6rpx;
}

.line {
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
  font-size: 26rpx;
  margin-bottom: 8rpx;
}

.row {
  display: flex;
  justify-content: space-between;
  margin-top: 8rpx;
  color: #555;
}

.row.strong {
  margin-top: 16rpx;
  font-weight: 700;
  font-size: 30rpx;
}

.price {
  color: #e64340;
}

.btn {
  border-radius: 999rpx;
  margin-top: 12rpx;
}

.hint {
  margin-top: 16rpx;
  color: #999;
  font-size: 22rpx;
  line-height: 1.5;
}
