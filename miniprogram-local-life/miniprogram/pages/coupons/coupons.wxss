.page {
  padding: 24rpx;
}

.card {
  background: linear-gradient(135deg, #fff7e6, #fff);
  border: 1rpx solid #ffe7ba;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.row {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}

.amt {
  font-size: 40rpx;
  font-weight: 800;
  color: #fa541c;
}

.name {
  font-weight: 700;
}

.muted {
  color: #888;
  font-size: 24rpx;
  margin-top: 8rpx;
}

.tip {
  color: #999;
  font-size: 22rpx;
  line-height: 1.5;
  margin-top: 12rpx;
}
