<view class="page">
  <view class="search-bar">
    <input class="search-input" placeholder="搜索商家或商品" value="{{keyword}}" bindinput="onKeyword" confirm-type="search" bindconfirm="onSearch" />
    <text class="search-btn" bindtap="onSearch">搜索</text>
  </view>

  <swiper class="banner" indicator-dots autoplay circular>
    <block wx:for="{{banners}}" wx:key="*this">
      <swiper-item>
        <view class="banner-item">{{item}}</view>
      </swiper-item>
    </block>
  </swiper>

  <view class="cats">
    <view
      class="cat {{activeCat===item.key?'active':''}}"
      wx:for="{{categories}}"
      wx:key="key"
      data-key="{{item.key}}"
      bindtap="onCat"
    >
      {{item.label}}
    </view>
  </view>

  <view class="list">
    <block wx:for="{{merchants}}" wx:key="_id">
      <view class="mcard" data-id="{{item._id}}" bindtap="openMerchant">
        <view class="mrow">
          <view class="mname">{{item.name}}</view>
          <view class="mrating">{{item.rating}} 分</view>
        </view>
        <view class="mrow muted">
          <text>月售 {{item.monthlySales}}+</text>
          <text>配送费 ¥{{item.deliveryFee}} · 起送 ¥{{item.minOrderAmount}}</text>
        </view>
      </view>
    </block>
    <view wx:if="{{!merchants.length}}" class="empty">暂无商家，请在「我的」初始化演示数据</view>
  </view>
</view>
