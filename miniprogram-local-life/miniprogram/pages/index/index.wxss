.page {
  padding-bottom: 24rpx;
}

.search-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #fff;
}

.search-input {
  flex: 1;
  height: 64rpx;
  background: #f2f3f5;
  border-radius: 999rpx;
  padding: 0 24rpx;
  font-size: 26rpx;
}

.search-btn {
  margin-left: 16rpx;
  color: #07c160;
  font-size: 28rpx;
}

.banner {
  height: 260rpx;
  margin: 16rpx 24rpx 0;
}

.banner-item {
  height: 100%;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #07c160, #2aa515);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
}

.cats {
  display: flex;
  flex-wrap: wrap;
  padding: 16rpx 24rpx 0;
  gap: 12rpx;
}

.cat {
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: #fff;
  color: #444;
  font-size: 24rpx;
}

.cat.active {
  background: #e8f8ef;
  color: #07c160;
  border: 1rpx solid #b7eb8f;
}

.list {
  padding: 16rpx 24rpx;
}

.mcard {
  background: #fff;
  border-radius: 16rpx;
  padding: 22rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.mrow {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.mname {
  font-size: 30rpx;
  font-weight: 600;
}

.mrating {
  color: #fa8c16;
  font-size: 26rpx;
}

.muted {
  color: #888;
  font-size: 24rpx;
}

.empty {
  text-align: center;
  color: #888;
  padding: 80rpx 0;
}
