.page {
  padding: 48rpx 32rpx;
}

.logo {
  font-size: 48rpx;
  font-weight: 700;
  text-align: center;
  margin-top: 40rpx;
}

.sub {
  text-align: center;
  color: #888;
  margin: 12rpx 0 40rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.label {
  font-size: 28rpx;
  margin-bottom: 16rpx;
  font-weight: 600;
}

.input {
  border: 1rpx solid #eee;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.btn {
  border-radius: 999rpx;
}

.btn.plain {
  background: #fff;
  color: #07c160;
  border: 1rpx solid #07c160;
}

.hint {
  margin-top: 16rpx;
  color: #999;
  font-size: 22rpx;
  line-height: 1.5;
}
