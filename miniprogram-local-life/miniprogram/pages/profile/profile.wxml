<view class="page">
  <view class="head">
    <image wx:if="{{user.avatarUrl}}" class="avatar" src="{{user.avatarUrl}}" mode="aspectFill" />
    <view wx:else class="avatar placeholder">{{avatarLetter}}</view>
    <view class="info">
      <view class="name">{{user.nickName||'邻刻达用户'}}</view>
      <view class="muted">手机 {{user.phone||'未绑定'}}</view>
    </view>
    <button size="mini" bindtap="goLogin">账号</button>
  </view>

  <view class="grid">
    <view class="cell" bindtap="goAddr">
      <view class="t">地址管理</view>
      <view class="s">收货地址</view>
    </view>
    <view class="cell" bindtap="goCoupons">
      <view class="t">优惠券</view>
      <view class="s">可用 {{user.couponCount||0}} 张</view>
    </view>
    <view class="cell">
      <view class="t">余额</view>
      <view class="s">¥{{balance}}</view>
    </view>
  </view>

  <view class="list">
    <view class="item" bindtap="goMerchantReg">商家入驻</view>
    <view class="item" bindtap="goMerchantDash">商家工作台</view>
    <view class="item" bindtap="goService">联系客服</view>
    <view class="item" bindtap="goSettings">设置</view>
    <view class="item" bindtap="seedDemo">初始化演示数据</view>
  </view>
</view>
