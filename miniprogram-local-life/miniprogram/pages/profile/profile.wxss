.page {
  padding-bottom: 24rpx;
}

.head {
  display: flex;
  align-items: center;
  padding: 32rpx 24rpx;
  background: #fff;
  gap: 16rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 999rpx;
  background: #eee;
}

.avatar.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  background: #07c160;
}

.info {
  flex: 1;
}

.name {
  font-size: 34rpx;
  font-weight: 700;
}

.muted {
  color: #888;
  font-size: 24rpx;
  margin-top: 8rpx;
}

.grid {
  display: flex;
  margin: 16rpx 24rpx;
  gap: 16rpx;
}

.cell {
  flex: 1;
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
}

.t {
  font-weight: 700;
}

.s {
  color: #888;
  font-size: 22rpx;
  margin-top: 8rpx;
}

.list {
  margin: 0 24rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.item {
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.item:last-child {
  border-bottom: none;
}
