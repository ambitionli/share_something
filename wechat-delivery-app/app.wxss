page {
  background: #f6f7fb;
  color: #1f2333;
  font-size: 28rpx;
  min-height: 100%;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx;
}

.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 12rpx 40rpx rgba(37, 55, 94, 0.06);
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.field {
  margin-bottom: 24rpx;
}

.field-label {
  display: block;
  margin-bottom: 12rpx;
  color: #4c5368;
}

.field-input,
.field-textarea,
.picker-value {
  width: 100%;
  box-sizing: border-box;
  background: #f4f6fb;
  border-radius: 20rpx;
  padding: 0 24rpx;
}

.field-input,
.picker-value {
  min-height: 88rpx;
  line-height: 88rpx;
}

.field-textarea {
  min-height: 180rpx;
  padding-top: 20rpx;
  padding-bottom: 20rpx;
  line-height: 1.6;
}

.primary-btn {
  background: linear-gradient(135deg, #2b62ff, #4b8cff);
  color: #ffffff;
  border-radius: 999rpx;
  font-size: 28rpx;
  line-height: 88rpx;
}

.ghost-btn {
  background: #eef3ff;
  color: #2b62ff;
  border-radius: 999rpx;
  font-size: 28rpx;
  line-height: 88rpx;
}

.status-pill {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #eef3ff;
  color: #2b62ff;
  font-size: 22rpx;
}

.muted {
  color: #7f8599;
}

.price {
  color: #ff5a3c;
  font-weight: 700;
}

.tag {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 16rpx;
  margin-right: 12rpx;
  margin-bottom: 12rpx;
  border-radius: 999rpx;
  background: #f2f4fa;
  color: #4c5368;
  font-size: 22rpx;
}

.empty {
  padding: 80rpx 24rpx;
  text-align: center;
  color: #7f8599;
}

.grid {
  display: grid;
  gap: 20rpx;
}

.two-col {
  grid-template-columns: repeat(2, 1fr);
}

.mini-tile {
  padding: 24rpx;
  background: #f5f7fd;
  border-radius: 20rpx;
}

.mini-value {
  font-size: 38rpx;
  font-weight: 700;
  color: #1c2233;
  margin-bottom: 10rpx;
}
