<view class="page">
  <view class="card">
    <view class="section-title">{{editing.id ? '编辑地址' : '新增地址'}}</view>
    <view class="field">
      <text class="field-label">收货人</text>
      <input class="field-input" value="{{editing.receiver}}" data-field="receiver" bindinput="onInput" />
    </view>
    <view class="field">
      <text class="field-label">手机号</text>
      <input class="field-input" type="number" maxlength="11" value="{{editing.phone}}" data-field="phone" bindinput="onInput" />
    </view>
    <view class="field">
      <text class="field-label">详细地址</text>
      <textarea class="field-textarea" value="{{editing.detail}}" data-field="detail" bindinput="onInput"></textarea>
    </view>
    <view class="field">
      <text class="field-label">标签</text>
      <input class="field-input" value="{{editing.tag}}" data-field="tag" bindinput="onInput" />
    </view>
    <label class="switch-row">
      <switch checked="{{editing.isDefault}}" bindchange="onDefaultChange" color="#2b62ff" />
      <text>设为默认地址</text>
    </label>
    <button class="primary-btn" bindtap="saveAddress">保存地址</button>
  </view>

  <view class="card">
    <view class="section-title">我的地址</view>
    <block wx:for="{{addresses}}" wx:key="id">
      <view class="address-item">
        <view class="address-header">
          <view>
            <text class="address-name">{{item.receiver}}</text>
            <text class="muted">{{item.phone}}</text>
          </view>
          <text class="status-pill" wx:if="{{item.isDefault}}">默认</text>
        </view>
        <view class="muted">{{item.tag}} · {{item.detail}}</view>
        <view class="action-row">
          <button class="ghost-btn mini-btn" data-id="{{item.id}}" bindtap="editAddress">编辑</button>
          <button class="ghost-btn mini-btn danger-btn" data-id="{{item.id}}" bindtap="deleteAddress">删除</button>
          <button wx:if="{{mode === 'select'}}" class="primary-btn mini-btn" data-id="{{item.id}}" bindtap="chooseAddress">选择</button>
        </view>
      </view>
    </block>
  </view>
</view>
