.address-row {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #eef1f6;
}

.address-row:last-child {
  border-bottom: none;
}

.address-main {
  flex: 1;
}

.address-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 10rpx;
}

.tag {
  font-size: 22rpx;
  color: #2b62ff;
  background: rgba(43, 98, 255, 0.12);
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
}

.default {
  color: #ff7a45;
  background: rgba(255, 122, 69, 0.12);
}

.address-actions {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.inline-form {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.checkbox-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
