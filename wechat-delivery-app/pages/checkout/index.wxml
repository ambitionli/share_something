<view class="page" wx:if="{{merchant}}">
  <view class="card address-card" bindtap="goChooseAddress">
    <view class="section-title">收货地址</view>
    <block wx:if="{{address}}">
      <view class="address-main">{{address.receiver}} {{address.phone}}</view>
      <view class="muted">{{address.tag}} · {{address.detail}}</view>
    </block>
    <view wx:else class="muted">点击选择收货地址</view>
  </view>

  <view class="card">
    <view class="section-title">{{merchant.name}}</view>
    <block wx:for="{{cart}}" wx:key="productId">
      <view class="order-item">
        <view>
          <view>{{item.name}}</view>
          <view class="muted">x{{item.quantity}}</view>
        </view>
        <view class="price">¥{{item.price}}</view>
      </view>
    </block>
    <textarea class="remark-box" placeholder="备注：少冰、放门口等" value="{{remark}}" bindinput="onRemarkInput" />
  </view>

  <view class="card">
    <view class="section-title">可用优惠券</view>
    <view class="coupon-list">
      <view class="coupon-item {{selectedCouponId === '' ? 'coupon-item-active' : ''}}" data-id="" bindtap="chooseCoupon">
        不使用优惠券
      </view>
      <block wx:for="{{availableCoupons}}" wx:key="id">
        <view class="coupon-item {{selectedCouponId === item.id ? 'coupon-item-active' : ''}}" data-id="{{item.id}}" bindtap="chooseCoupon">
          {{item.title}} - 减 {{item.amount}} 元
        </view>
      </block>
    </view>
  </view>

  <view class="card" wx:if="{{summary}}">
    <view class="summary-row">
      <text>商品金额</text>
      <text>¥{{summary.itemsTotal}}</text>
    </view>
    <view class="summary-row">
      <text>配送费</text>
      <text>¥{{summary.deliveryFee}}</text>
    </view>
    <view class="summary-row">
      <text>优惠金额</text>
      <text>-¥{{summary.discountAmount}}</text>
    </view>
    <view class="summary-row total-row">
      <text>应付</text>
      <text class="price">¥{{summary.payableAmount}}</text>
    </view>
  </view>

  <view class="action-bar">
    <button class="ghost-btn action-btn" data-pay="" bindtap="submitOrder">先下单后支付</button>
    <button class="primary-btn action-btn" data-pay="1" bindtap="submitOrder">模拟支付并下单</button>
  </view>
</view>
