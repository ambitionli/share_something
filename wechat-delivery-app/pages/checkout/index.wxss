.address-card {
  margin-bottom: 20rpx;
}

.address-main {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.order-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f0f2f7;
}

.remark-box {
  width: 100%;
  height: 140rpx;
  background: #f5f7fd;
  border-radius: 20rpx;
  padding: 18rpx 20rpx;
  box-sizing: border-box;
  margin-top: 24rpx;
}

.coupon-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.coupon-item {
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: #f5f7fd;
  color: #4c5368;
}

.coupon-item-active {
  background: #edf3ff;
  color: #2b62ff;
  border: 1rpx solid #2b62ff;
}

.summary-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.total-row {
  margin-top: 10rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f2f7;
  font-weight: 600;
}

.action-bar {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
}

.action-btn {
  flex: 1;
  margin: 0;
}
