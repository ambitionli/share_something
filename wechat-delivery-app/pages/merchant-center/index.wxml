<view class="page merchant-page">
  <view class="card">
    <view class="section-title">商家工作台</view>
    <view class="muted">切换到商家演示账号后，可直接完成接单、商品编辑、退款处理和数据验收。</view>
  </view>

  <view class="card" wx:if="{{!merchant}}">
    <view class="section-title">商家入驻</view>
    <view class="field">
      <text class="field-label">商家名称</text>
      <input class="field-input" value="{{joinForm.name}}" data-field="name" bindinput="onJoinInput" />
    </view>
    <view class="field">
      <text class="field-label">经营分类</text>
      <picker mode="selector" range="{{categoryNames}}" value="{{joinCategoryIndex}}" bindchange="onCategoryChange">
        <view class="picker-value">{{categoryNames[joinCategoryIndex]}}</view>
      </picker>
    </view>
    <view class="field">
      <text class="field-label">门店地址</text>
      <input class="field-input" value="{{joinForm.address}}" data-field="address" bindinput="onJoinInput" />
    </view>
    <view class="field split">
      <view class="split-item">
        <text class="field-label">配送费</text>
        <input class="field-input" type="digit" value="{{joinForm.deliveryFee}}" data-field="deliveryFee" bindinput="onJoinInput" />
      </view>
      <view class="split-item">
        <text class="field-label">起送价</text>
        <input class="field-input" type="digit" value="{{joinForm.minOrderAmount}}" data-field="minOrderAmount" bindinput="onJoinInput" />
      </view>
    </view>
    <view class="field">
      <text class="field-label">平均配送时长（分钟）</text>
      <input class="field-input" type="number" value="{{joinForm.avgDeliveryMinutes}}" data-field="avgDeliveryMinutes" bindinput="onJoinInput" />
    </view>
    <view class="field">
      <text class="field-label">门店公告</text>
      <textarea class="field-textarea" value="{{joinForm.notice}}" data-field="notice" bindinput="onJoinInput"></textarea>
    </view>
    <view class="section-title small-title">资质上传（模拟）</view>
    <view class="tag-wrap">
      <block wx:for="{{certOptions}}" wx:key="*this">
        <view class="cert-tag {{selectedCerts[item] ? 'cert-tag-active' : ''}}" data-cert="{{item}}" bindtap="toggleCert">
          {{item}}
        </view>
      </block>
    </view>
    <button class="primary-btn submit-btn" bindtap="submitJoin">提交入驻申请</button>
  </view>

  <block wx:if="{{merchant}}">
    <view class="card">
      <view class="row-top">
        <view>
          <view class="merchant-name">{{merchant.name}}</view>
          <view class="muted">{{merchant.address}}</view>
        </view>
        <view class="status-pill">{{merchant.status === 'approved' ? '已入驻' : '审核中'}}</view>
      </view>
      <view class="muted">{{merchant.notice}}</view>
      <view class="tag-wrap merchant-tags">
        <block wx:for="{{merchant.certifications}}" wx:key="*this">
          <text class="mini-tag">{{item}}</text>
        </block>
      </view>
    </view>

    <view class="card">
      <view class="section-title">商品管理</view>
      <view class="field">
        <text class="field-label">商品名称</text>
        <input class="field-input" value="{{productForm.name}}" data-field="name" bindinput="onProductInput" />
      </view>
      <view class="field split">
        <view class="split-item">
          <text class="field-label">售价</text>
          <input class="field-input" type="digit" value="{{productForm.price}}" data-field="price" bindinput="onProductInput" />
        </view>
        <view class="split-item">
          <text class="field-label">原价</text>
          <input class="field-input" type="digit" value="{{productForm.originalPrice}}" data-field="originalPrice" bindinput="onProductInput" />
        </view>
      </view>
      <view class="field split">
        <view class="split-item">
          <text class="field-label">库存</text>
          <input class="field-input" type="number" value="{{productForm.stock}}" data-field="stock" bindinput="onProductInput" />
        </view>
        <view class="split-item">
          <text class="field-label">标签</text>
          <input class="field-input" value="{{productForm.tagsText}}" data-field="tagsText" bindinput="onProductInput" />
        </view>
      </view>
      <view class="field">
        <text class="field-label">描述</text>
        <textarea class="field-textarea" value="{{productForm.description}}" data-field="description" bindinput="onProductInput"></textarea>
      </view>
      <view class="switch-row">
        <text>上架销售</text>
        <switch checked="{{productForm.isOnShelf}}" bindchange="onProductShelfChange" color="#2b62ff" />
      </view>
      <view class="actions-inline">
        <button class="primary-btn flex-btn" bindtap="saveProduct">保存商品</button>
        <button class="ghost-btn flex-btn" bindtap="resetProductForm">清空表单</button>
      </view>
      <view class="list">
        <block wx:for="{{products}}" wx:key="id">
          <view class="list-card">
            <view class="row-top">
              <view>
                <view class="list-title">{{item.name}}</view>
                <view class="subtle">售价 ¥{{item.price}} / 库存 {{item.stock}} / 销量 {{item.sales}}</view>
              </view>
              <view class="status-pill">{{item.isOnShelf ? '已上架' : '已下架'}}</view>
            </view>
            <view class="subtle">{{item.description}}</view>
            <view class="tag-wrap merchant-tags">
              <block wx:for="{{item.tags}}" wx:key="*this">
                <text class="mini-tag">{{item}}</text>
              </block>
            </view>
            <view class="actions-inline">
              <button class="ghost-btn flex-btn" data-id="{{item.id}}" bindtap="editProduct">编辑</button>
              <button class="ghost-btn flex-btn" data-id="{{item.id}}" data-shelf="{{item.isOnShelf ? '0' : '1'}}" bindtap="switchShelf">
                {{item.isOnShelf ? '下架' : '上架'}}
              </button>
            </view>
          </view>
        </block>
      </view>
    </view>

    <view class="card">
      <view class="section-title">订单管理</view>
      <block wx:if="{{orders.length}}">
        <block wx:for="{{orders}}" wx:key="id">
          <view class="list-card">
            <view class="row-top">
              <view>
                <view class="list-title">{{item.orderNo}}</view>
                <view class="subtle">{{item.user.nickname}} · {{item.address.detail}}</view>
              </view>
              <view class="status-pill">{{item.statusLabel}}</view>
            </view>
            <view class="subtle">实付 ¥{{item.summary.payableAmount}} · {{item.createdAt}}</view>
            <view class="tag-wrap merchant-tags">
              <block wx:for="{{item.items}}" wx:key="productId">
                <text class="mini-tag">{{item.name}} x{{item.quantity}}</text>
              </block>
            </view>
            <view class="actions-inline">
              <button wx:if="{{item.status === 'pending_acceptance'}}" class="primary-btn flex-btn" data-id="{{item.id}}" bindtap="acceptOrder">接单</button>
              <button wx:if="{{item.status === 'pending_acceptance'}}" class="ghost-btn flex-btn" data-id="{{item.id}}" bindtap="rejectOrder">拒单</button>
              <button wx:if="{{item.status === 'accepted'}}" class="primary-btn flex-btn" data-id="{{item.id}}" bindtap="markDelivering">标记配送</button>
              <button wx:if="{{item.status === 'refund_requested'}}" class="primary-btn flex-btn" data-id="{{item.id}}" data-approve="1" bindtap="handleRefund">通过退款</button>
              <button wx:if="{{item.status === 'refund_requested'}}" class="ghost-btn flex-btn" data-id="{{item.id}}" data-approve="0" bindtap="handleRefund">驳回退款</button>
            </view>
          </view>
        </block>
      </block>
      <view wx:else class="empty">暂无待处理订单</view>
    </view>

    <view class="card" wx:if="{{stats}}">
      <view class="section-title">数据概览</view>
      <view class="stats-grid">
        <view class="stats-card">
          <view class="stats-value">{{stats.totalOrders}}</view>
          <view class="subtle">订单总量</view>
        </view>
        <view class="stats-card">
          <view class="stats-value">{{stats.completedOrders}}</view>
          <view class="subtle">已完成</view>
        </view>
        <view class="stats-card">
          <view class="stats-value">{{stats.refundedOrders}}</view>
          <view class="subtle">退款 / 拒单</view>
        </view>
        <view class="stats-card">
          <view class="stats-value">¥{{stats.revenue}}</view>
          <view class="subtle">累计收入</view>
        </view>
      </view>
    </view>
  </block>
</view>
