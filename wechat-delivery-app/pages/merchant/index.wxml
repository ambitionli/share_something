<view class="page" wx:if="{{merchant}}">
  <view class="merchant-banner card">
    <view class="merchant-header">
      <view class="logo">{{merchant.logoText}}</view>
      <view class="merchant-main">
        <view class="merchant-name">{{merchant.name}}</view>
        <view class="muted">{{merchant.notice}}</view>
      </view>
    </view>
    <view class="merchant-meta">
      <text>评分 {{merchant.rating}}</text>
      <text>月售 {{merchant.monthlySales}}</text>
      <text>配送费 ¥{{merchant.deliveryFee}}</text>
      <text>起送价 ¥{{merchant.minOrderAmount}}</text>
    </view>
    <view>
      <block wx:for="{{merchant.certifications}}" wx:key="*this">
        <text class="tag">{{item}}</text>
      </block>
    </view>
  </view>

  <view class="section-title">商品列表</view>
  <block wx:for="{{products}}" wx:key="id">
    <view class="product-card card">
      <view class="product-main">
        <view class="product-name">{{item.name}}</view>
        <view class="muted product-desc">{{item.description}}</view>
        <view>
          <block wx:for="{{item.tags}}" wx:key="*this">
            <text class="tag">{{item}}</text>
          </block>
        </view>
        <view class="product-footer">
          <view>
            <text class="price">¥{{item.price}}</text>
            <text class="muted original-price">¥{{item.originalPrice}}</text>
          </view>
          <view class="counter">
            <text class="counter-btn" data-id="{{item.id}}" data-delta="-1" bindtap="changeCount">-</text>
            <text class="counter-value">{{cartCountMap[item.id] || 0}}</text>
            <text class="counter-btn counter-btn-active" data-id="{{item.id}}" data-delta="1" bindtap="changeCount">+</text>
          </view>
        </view>
      </view>
    </view>
  </block>

  <view class="section-title">商家评价</view>
  <block wx:if="{{reviews.length}}">
    <block wx:for="{{reviews}}" wx:key="id">
      <view class="card review-card">
        <view class="review-rating">评分 {{item.rating}} 星</view>
        <view>{{item.content}}</view>
      </view>
    </block>
  </block>
  <view wx:else class="empty card">暂无评价，欢迎成为首位评价用户</view>

  <view class="cart-bar">
    <view class="cart-summary">
      <view>已选 {{selectedCount}} 件</view>
      <view class="price">合计 ¥{{selectedAmount}}</view>
    </view>
    <button class="primary-btn cart-btn" bindtap="openCheckout">去结算</button>
  </view>
</view>
