.merchant-banner {
  margin-bottom: 24rpx;
}

.merchant-header {
  display: flex;
  align-items: center;
}

.logo {
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #edf2ff, #dbe7ff);
  color: #2b62ff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  font-weight: 700;
  margin-right: 20rpx;
}

.merchant-main {
  flex: 1;
}

.merchant-name {
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.merchant-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx 24rpx;
  margin: 20rpx 0;
  color: #4c5368;
  font-size: 24rpx;
}

.product-card {
  margin-bottom: 20rpx;
}

.product-name {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 10rpx;
}

.product-desc {
  margin-bottom: 14rpx;
}

.product-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 14rpx;
}

.original-price {
  margin-left: 12rpx;
  text-decoration: line-through;
}

.counter {
  display: flex;
  align-items: center;
}

.counter-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #eef2fb;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  color: #2f3854;
}

.counter-btn-active {
  background: #2b62ff;
  color: #ffffff;
}

.counter-value {
  min-width: 60rpx;
  text-align: center;
}

.review-card {
  margin-bottom: 16rpx;
}

.review-rating {
  font-weight: 600;
  margin-bottom: 10rpx;
}

.cart-bar {
  position: sticky;
  bottom: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  background: rgba(31, 35, 51, 0.92);
  border-radius: 999rpx;
  color: #ffffff;
  margin-top: 24rpx;
}

.cart-summary {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.cart-btn {
  width: 220rpx;
  margin: 0;
}
