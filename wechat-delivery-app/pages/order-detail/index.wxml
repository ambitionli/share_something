<view class="page" wx:if="{{order}}">
  <view class="card">
    <view class="order-header">
      <view class="merchant-name">{{order.merchant.name}}</view>
      <view class="status-pill">{{order.statusLabel}}</view>
    </view>
    <view class="muted">订单号：{{order.orderNo}}</view>
    <view class="muted">下单时间：{{order.createdAt}}</view>
  </view>

  <view class="card">
    <view class="section-title">配送信息</view>
    <view>{{order.address.receiver}} {{order.address.phone}}</view>
    <view class="muted">{{order.address.tag}} · {{order.address.detail}}</view>
    <view class="muted" wx:if="{{order.remark}}">备注：{{order.remark}}</view>
  </view>

  <view class="card">
    <view class="section-title">商品明细</view>
    <block wx:for="{{order.items}}" wx:key="productId">
      <view class="goods-row">
        <text>{{item.name}}</text>
        <text>x{{item.quantity}}</text>
      </view>
    </block>
    <view class="summary-row">
      <text>商品金额</text>
      <text>¥{{order.summary.itemsTotal}}</text>
    </view>
    <view class="summary-row">
      <text>配送费</text>
      <text>¥{{order.summary.deliveryFee}}</text>
    </view>
    <view class="summary-row">
      <text>优惠</text>
      <text>-¥{{order.summary.discountAmount}}</text>
    </view>
    <view class="summary-row total-row">
      <text>实际支付</text>
      <text class="price">¥{{order.summary.payableAmount}}</text>
    </view>
  </view>

  <view class="card">
    <view class="section-title">订单轨迹</view>
    <block wx:for="{{order.timeline}}" wx:key="time">
      <view class="timeline-row">
        <text>{{item.label}}</text>
        <text class="muted">{{item.time}}</text>
      </view>
    </block>
  </view>

  <view class="card" wx:if="{{order.review}}">
    <view class="section-title">我的评价</view>
    <view>评分 {{order.review.rating}} 星</view>
    <view class="muted">{{order.review.content}}</view>
  </view>

  <view class="action-bar">
    <button wx:if="{{order.status === 'pending_payment'}}" class="primary-btn action-btn" bindtap="payOrder">模拟支付</button>
    <button wx:if="{{order.status === 'pending_acceptance' || order.status === 'accepted' || order.status === 'delivering'}}" class="ghost-btn action-btn" bindtap="requestRefund">申请退款</button>
    <button wx:if="{{order.status === 'delivering'}}" class="primary-btn action-btn" bindtap="confirmOrder">确认收货</button>
    <button wx:if="{{order.status === 'completed' && !order.reviewId}}" class="primary-btn action-btn" bindtap="goReview">去评价</button>
  </view>
</view>
