.card {
  margin-bottom: 20rpx;
}

.order-header,
.summary-row,
.timeline-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.merchant-name {
  font-size: 32rpx;
  font-weight: 700;
}

.goods-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f3f4f6;
}

.goods-row:last-child {
  border-bottom: none;
}

.summary-row {
  margin-bottom: 14rpx;
}

.total-row {
  margin-top: 10rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #eef1f8;
  font-weight: 700;
}

.timeline-row {
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f3f4f6;
}

.timeline-row:last-child {
  border-bottom: none;
}

.action-bar {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}

.action-btn {
  flex: 1;
  margin: 0;
}
