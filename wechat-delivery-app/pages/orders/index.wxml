<view class="page">
  <scroll-view class="tab-scroll" scroll-x>
    <view class="tab-list">
      <block wx:for="{{tabs}}" wx:key="*this">
        <view class="tab-item {{activeTab === item ? 'tab-item-active' : ''}}" data-tab="{{item}}" bindtap="switchTab">
          {{item}}
        </view>
      </block>
    </view>
  </scroll-view>

  <block wx:if="{{orders.length}}">
    <block wx:for="{{orders}}" wx:key="id">
      <view class="card order-card" data-id="{{item.id}}" bindtap="openDetail">
        <view class="order-header">
          <text class="order-name">{{item.merchant.name}}</text>
          <text class="status-pill">{{item.statusLabel}}</text>
        </view>
        <view class="muted order-time">{{item.createdAt}}</view>
        <block wx:for="{{item.items}}" wx:key="productId">
          <view class="order-item">
            <text>{{item.name}}</text>
            <text>x{{item.quantity}}</text>
          </view>
        </block>
        <view class="order-footer">
          <text>合计 <text class="price">¥{{item.summary.payableAmount}}</text></text>
          <button wx:if="{{item.status === 'pending_payment'}}" class="mini-btn" data-id="{{item.id}}" bindtap.stop="payOrder">去支付</button>
        </view>
      </view>
    </block>
  </block>
  <view wx:else class="empty">暂无订单</view>
</view>
