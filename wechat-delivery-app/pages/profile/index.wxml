<view class="page">
  <view class="card user-card" wx:if="{{user}}">
    <view class="avatar">{{user.avatarText}}</view>
    <view class="user-meta">
      <view class="user-name">{{user.nickname}}</view>
      <view class="muted">{{user.phone}}</view>
    </view>
    <view class="balance">余额 ¥{{user.balance}}</view>
  </view>

  <view class="card">
    <view class="section-title">服务能力</view>
    <view class="grid two-col">
      <view class="mini-tile">
        <view class="mini-value">{{addresses.length}}</view>
        <view class="muted">收货地址</view>
      </view>
      <view class="mini-tile">
        <view class="mini-value">{{coupons.length}}</view>
        <view class="muted">优惠券</view>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="section-title">常用服务</view>
    <view class="list-row" bindtap="goAddresses">
      <text>地址管理</text>
      <text class="muted">维护收货地址 ></text>
    </view>
    <view class="list-row" bindtap="openSupport">
      <text>联系客服</text>
      <text class="muted">{{support.phone}} ></text>
    </view>
    <view class="list-row" bindtap="openMerchantCenter">
      <text>商家中心</text>
      <text class="muted">{{merchant ? merchant.name : '申请入驻'}} ></text>
    </view>
    <view class="list-row" bindtap="resetDemo">
      <text>恢复演示数据</text>
      <text class="muted">清空本地模拟状态 ></text>
    </view>
  </view>

  <view class="card">
    <view class="section-title">演示账号切换</view>
    <block wx:for="{{quickUsers}}" wx:key="phone">
      <view class="list-row" data-phone="{{item.phone}}" data-nickname="{{item.nickname}}" bindtap="switchDemoUser">
        <text>{{item.label}}</text>
        <text class="muted">{{item.phone}} ></text>
      </view>
    </block>
  </view>

  <view class="card">
    <view class="section-title">优惠券</view>
    <block wx:for="{{coupons}}" wx:key="id">
      <view class="coupon-row">
        <view>
          <view>{{item.title}}</view>
          <view class="muted">满 {{item.minimumSpend}} 可用</view>
        </view>
        <view class="coupon-amount">¥{{item.amount}}</view>
      </view>
    </block>
  </view>
</view>
