.profile-header {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 48rpx;
  background: linear-gradient(135deg, #2b62ff, #5f8bff);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: 700;
}

.profile-name {
  font-size: 34rpx;
  font-weight: 700;
}

.profile-phone {
  margin-top: 8rpx;
  color: #7f8599;
}

.summary-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
}

.summary-item {
  padding: 24rpx 20rpx;
  background: #f6f8ff;
  border-radius: 24rpx;
  text-align: center;
}

.summary-value {
  font-size: 34rpx;
  font-weight: 700;
  color: #2b62ff;
}

.summary-label {
  margin-top: 10rpx;
  color: #7f8599;
}

.list-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #eef1f8;
}

.list-row:last-child {
  border-bottom: none;
}

.coupon-row,
.address-row {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eef1f8;
}

.coupon-row:last-child,
.address-row:last-child {
  border-bottom: none;
}

.coupon-title,
.address-title {
  font-weight: 600;
}

.coupon-meta,
.address-meta {
  margin-top: 10rpx;
  color: #7f8599;
}
