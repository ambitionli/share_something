.review-page {
  padding-bottom: 40rpx;
}

.stars {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.star {
  font-size: 48rpx;
  color: #c6cada;
}

.star.active {
  color: #ff9f1a;
}

.image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin: 20rpx 0;
}

.image-chip {
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: #eef3ff;
  color: #2b62ff;
  font-size: 24rpx;
}

.submit-btn {
  margin-top: 20rpx;
}
