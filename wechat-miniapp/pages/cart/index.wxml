<view class="page">
  <view class="card">
    <view class="space-between">
      <view class="section-title">购物车</view>
      <button class="btn-light" bindtap="clearCart">清空</button>
    </view>
    <view wx:if="{{!cart.items.length}}" class="empty">
      <view>购物车还是空的</view>
      <view style="height: 20rpx;"></view>
      <button class="btn-primary" bindtap="goHome">去逛逛</button>
    </view>
    <view wx:for="{{cart.items}}" wx:key="productId" class="list-item">
      <view class="space-between" style="align-items:flex-start;">
        <view style="flex:1;">
          <view style="font-weight:700;">{{item.name}}</view>
          <view class="muted" style="margin: 8rpx 0;">{{item.merchantName}}</view>
          <view class="price">¥{{item.price}}</view>
        </view>
        <view class="row">
          <button class="btn-light" data-id="{{item.productId}}" bindtap="decrease">-</button>
          <view style="margin: 0 20rpx;">{{item.quantity}}</view>
          <button class="btn-primary" data-id="{{item.productId}}" bindtap="increase">+</button>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{cart.items.length}}" class="sticky-footer">
    <view class="space-between">
      <view>
        <view>小计 ¥{{cart.subtotalText}}</view>
        <view class="muted">配送费 ¥{{cart.deliveryFeeText}} · 打包费 ¥{{cart.packageFeeText}}</view>
      </view>
      <view class="price">¥{{cart.totalText}}</view>
    </view>
    <view style="height: 16rpx;"></view>
    <button class="btn-primary" bindtap="goCheckout">去结算</button>
  </view>
</view>
