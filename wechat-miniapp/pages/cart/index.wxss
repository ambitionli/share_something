.action-btn {
  margin-top: 24rpx;
}

.cart-card {
  margin-bottom: 20rpx;
}

.cart-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.merchant-name {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.head-btn {
  font-size: 24rpx;
  line-height: 60rpx;
  padding: 0 24rpx;
}

.item-row {
  display: flex;
  gap: 16rpx;
  padding: 20rpx 0;
  border-top: 2rpx solid #f2f4f8;
}

.item-cover {
  width: 144rpx;
  height: 144rpx;
  border-radius: 18rpx;
  flex-shrink: 0;
}

.item-content {
  flex: 1;
}

.item-name {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 10rpx;
}

.item-foot {
  margin-top: 18rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.item-price,
.total,
.summary-title {
  font-size: 30rpx;
  font-weight: 700;
}

.stepper {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.step-btn {
  width: 54rpx;
  height: 54rpx;
  line-height: 54rpx;
  border-radius: 50%;
  background: #eef2f8;
  padding: 0;
}

.step-btn.active {
  background: #ff5a44;
  color: #ffffff;
}

.qty {
  min-width: 32rpx;
  text-align: center;
}

.checkout-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid #f2f4f8;
}

.checkout-btn {
  width: 220rpx;
}

.summary-card {
  display: flex;
  justify-content: space-between;
}
