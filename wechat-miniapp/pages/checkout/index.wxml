<view class="page">
  <view wx:if="{{!summary}}" class="card empty">
    购物车为空，请先去商家页加购商品
  </view>

  <block wx:if="{{summary}}">
    <view class="card section-card">
      <view class="section-title">配送地址</view>
      <view wx:if="{{addressList.length === 0}}" class="muted">暂无地址，请先新增一个地址</view>
      <radio-group bindchange="onAddressChange">
        <label wx:for="{{addressList}}" wx:key="id" class="address-item">
          <radio value="{{item.id}}" checked="{{selectedAddressId === item.id}}" color="#ff5a44"></radio>
          <view class="address-content">
            <view class="address-top">
              <view class="address-name">{{item.name}} {{item.phone}}</view>
              <view class="tag">{{item.tag}}</view>
            </view>
            <view class="muted">{{item.city}} {{item.detail}}</view>
          </view>
        </label>
      </radio-group>
      <button class="ghost-btn action-btn" bindtap="addAddress">新增测试地址</button>
    </view>

    <view class="card section-card">
      <view class="section-title">订单商品</view>
      <view class="merchant-line">{{merchant.name}}</view>
      <view wx:for="{{summary.items}}" wx:key="productId" class="goods-item">
        <image class="goods-image" src="{{item.image}}" mode="aspectFill"></image>
        <view class="goods-content">
          <view class="goods-name">{{item.name}}</view>
          <view class="muted">单价 {{item.priceDisplay}} × {{item.quantity}}</view>
        </view>
        <view class="goods-subtotal">{{item.subtotalDisplay}}</view>
      </view>
    </view>

    <view class="card section-card">
      <view class="section-title">订单备注</view>
      <textarea class="textarea" value="{{remark}}" bindinput="onRemarkInput" placeholder="口味、送达时间、门禁等备注"></textarea>
      <view class="coupon-row">
        <input class="input" value="{{couponCode}}" bindinput="onCouponInput" placeholder="输入优惠券备注码（演示字段）" />
      </view>
    </view>

    <view class="card sticky-bottom pay-bar">
      <view class="price-block">
        <view class="price-main">实付 {{summary.payableAmountDisplay}}</view>
        <view class="muted">商品 {{summary.goodsAmountDisplay}} + 配送费 {{summary.deliveryFeeDisplay}}</view>
      </view>
      <button class="primary-btn submit-btn" bindtap="submitOrder">提交订单</button>
    </view>
  </block>
</view>
