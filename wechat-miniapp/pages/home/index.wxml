<view class="page">
  <view class="card">
    <view class="section-title">今晚吃点啥</view>
    <input class="input" placeholder="搜索商家、商品、标签" value="{{keyword}}" bindinput="handleKeywordInput" confirm-type="search" bindconfirm="search" />
    <button class="btn-primary" bindtap="search">立即搜索</button>
  </view>

  <swiper class="banner" autoplay interval="3000" circular>
    <block wx:for="{{banners}}" wx:key="id">
      <swiper-item>
        <image src="{{item.image}}" mode="aspectFill"></image>
      </swiper-item>
    </block>
  </swiper>

  <view class="card">
    <view class="section-title">分类</view>
    <view class="wrap">
      <view
        wx:for="{{categories}}"
        wx:key="id"
        class="chip"
        style="{{activeCategoryId === item.id ? 'background:#7f5af0;color:#ffffff;' : ''}}"
        data-id="{{item.id}}"
        bindtap="selectCategory"
      >
        {{item.icon}} {{item.name}}
      </view>
    </view>
  </view>

  <view class="card">
    <view class="section-title">推荐商家</view>
    <view wx:if="{{!merchants.length}}" class="empty">没有找到符合条件的商家</view>
    <view
      wx:for="{{merchants}}"
      wx:key="id"
      class="list-item"
      data-id="{{item.id}}"
      bindtap="openMerchant"
    >
      <view class="space-between" style="align-items:flex-start;">
        <view>
          <view style="font-size: 32rpx; font-weight: 700;">{{item.name}}</view>
          <view class="muted" style="margin: 8rpx 0;">{{item.announcement}}</view>
          <view class="muted">评分 {{item.scoreText}} · 月售 {{item.monthlySales}} · 配送费 {{item.deliveryFee}} 元</view>
        </view>
        <view class="pill-status">{{item.averageDeliveryMinutes}} 分钟</view>
      </view>
      <view class="wrap" style="margin-top: 16rpx;">
        <text wx:for="{{item.tags}}" wx:key="*this" class="chip">{{item}}</text>
      </view>
      <view class="muted" style="margin-top: 12rpx;">热卖：{{item.products[0].name}} / {{item.products[1] ? item.products[1].name : '更多商品'}}</view>
    </view>
  </view>
</view>
