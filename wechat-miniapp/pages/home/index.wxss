.top-card {
  margin-bottom: 24rpx;
}

.top-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
}

.title {
  font-size: 38rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.mini-btn {
  padding: 0 28rpx;
  font-size: 24rpx;
  line-height: 60rpx;
}

.search-row {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.search-input {
  flex: 1;
}

.search-btn {
  width: 180rpx;
}

.banner-swiper {
  height: 260rpx;
  margin-bottom: 24rpx;
}

.banner-item {
  height: 100%;
  border-radius: 24rpx;
  overflow: hidden;
  background-size: cover;
  background-position: center;
}

.banner-mask {
  height: 100%;
  padding: 32rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  color: #ffffff;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0.06), rgba(0, 0, 0, 0.38));
}

.banner-title {
  font-size: 40rpx;
  font-weight: 700;
}

.banner-subtitle {
  margin-top: 8rpx;
  font-size: 24rpx;
}

.category-card {
  margin-bottom: 24rpx;
}

.category-list {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 16rpx;
}

.category-item {
  background: #f7f8fc;
  border-radius: 18rpx;
  padding: 20rpx 8rpx;
  text-align: center;
}

.category-item.active {
  background: #fff2ef;
  border: 2rpx solid #ffd3c7;
}

.emoji {
  font-size: 38rpx;
  margin-bottom: 8rpx;
}

.category-name {
  font-size: 24rpx;
}

.merchant-title {
  margin-bottom: 20rpx;
}

.merchant-card {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.merchant-cover {
  width: 188rpx;
  height: 188rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
}

.merchant-content {
  flex: 1;
}

.merchant-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.merchant-name {
  font-size: 32rpx;
  font-weight: 700;
}

.merchant-info {
  margin-top: 8rpx;
}

.merchant-desc {
  margin-top: 10rpx;
  font-size: 26rpx;
  line-height: 1.5;
}

.recommend-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.recommend-tag {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #f4f6fb;
  color: #56627a;
  font-size: 22rpx;
}
