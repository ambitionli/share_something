<view class="container">
  <view class="card" wx:if="{{merchant}}">
    <view class="section-title">商品管理 - {{merchant.name}}</view>
    <view class="muted">支持上架、下架、改价和修改库存。</view>
  </view>

  <view class="card">
    <view class="section-title">{{form.id ? '编辑商品' : '新增商品'}}</view>
    <input class="input" placeholder="商品名" data-key="name" value="{{form.name}}" bindinput="onFieldInput" />
    <input class="input" placeholder="商品描述" data-key="description" value="{{form.description}}" bindinput="onFieldInput" />
    <input class="input" type="digit" placeholder="价格" data-key="price" value="{{form.price}}" bindinput="onFieldInput" />
    <input class="input" type="number" placeholder="库存" data-key="stock" value="{{form.stock}}" bindinput="onFieldInput" />
    <input class="input" placeholder="单位" data-key="unit" value="{{form.unit}}" bindinput="onFieldInput" />
    <button class="primary-btn" bindtap="saveProduct">保存商品</button>
  </view>

  <view class="card">
    <view class="section-title">商品列表</view>
    <view class="list-item" wx:for="{{products}}" wx:key="id">
      <view class="row space-between">
        <view>
          <view>{{item.name}}</view>
          <view class="muted">{{item.description}}</view>
          <view class="muted">{{item.stock}}{{item.unit}} · 已售 {{item.soldCount}}</view>
          <view class="price">{{item.price}} 元 · {{item.status === 'on' ? '已上架' : '已下架'}}</view>
        </view>
        <view class="row" style="gap: 12rpx;">
          <button class="ghost-btn" size="mini" data-product="{{item}}" bindtap="editProduct">编辑</button>
          <button class="secondary-btn" size="mini" data-id="{{item.id}}" bindtap="toggleProduct">上下架</button>
        </view>
      </view>
    </view>
  </view>
</view>
