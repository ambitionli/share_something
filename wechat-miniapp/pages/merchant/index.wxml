<view class="page" wx:if="{{merchant}}">
  <image class="banner" src="{{merchant.banner}}" mode="aspectFill"></image>

  <view class="card">
    <view class="space-between">
      <view>
        <view class="section-title">{{merchant.name}}</view>
        <view class="muted">{{merchant.announcement}}</view>
      </view>
      <view class="pill-status">评分 {{merchant.scoreText}}</view>
    </view>
    <view class="muted" style="margin-top: 16rpx;">配送费 {{merchant.deliveryFee}} 元 · 起送价 {{merchant.minOrderPrice}} 元 · 平均 {{merchant.averageDeliveryMinutes}} 分钟送达</view>
    <view class="wrap" style="margin-top: 16rpx;">
      <text wx:for="{{merchant.tags}}" wx:key="*this" class="chip">{{item}}</text>
    </view>
  </view>

  <view class="card">
    <view class="space-between">
      <view class="section-title">商品列表</view>
      <button class="btn-light" bindtap="goCart">查看购物车</button>
    </view>
    <view wx:for="{{products}}" wx:key="id" class="list-item">
      <view class="row" style="align-items:flex-start;">
        <image class="cover" src="{{item.image}}" mode="aspectFill"></image>
        <view style="flex:1;">
          <view class="space-between" style="align-items:flex-start;">
            <view>
              <view style="font-weight:700;">{{item.name}}</view>
              <view class="muted" style="margin: 8rpx 0;">{{item.description}}</view>
              <view class="muted">月售 {{item.monthlySales}} · 评分 {{item.rating}}</view>
            </view>
            <view class="price">¥{{item.priceText}}</view>
          </view>
          <view class="action-row">
            <button class="btn-primary" data-id="{{item.id}}" bindtap="addToCart" disabled="{{!item.onShelf}}">{{item.onShelf ? '加入购物车' : '已下架'}}</button>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="section-title">用户评价</view>
    <view wx:if="{{!reviews.length}}" class="empty">暂无评价</view>
    <view wx:for="{{reviews}}" wx:key="id" class="list-item">
      <view class="space-between">
        <text>{{item.content || '用户给出了好评'}}</text>
        <text class="pill-status">★ {{item.rating}}</text>
      </view>
      <view class="muted" style="margin-top: 8rpx;">{{item.createdAt}}</view>
    </view>
  </view>
</view>
