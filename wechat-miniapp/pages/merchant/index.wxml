<view class="container">
  <view class="card" wx:if="{{merchant}}">
    <view class="section-title">{{merchant.name}}</view>
    <view class="muted">{{merchant.category}} · 评分 {{merchant.rating}} · 月售 {{merchant.sales}}</view>
    <view class="muted">配送费 {{merchant.deliveryFee}} 元 · 起送 {{merchant.minOrderAmount}} 元</view>
    <view class="muted">{{merchant.notice}}</view>
  </view>

  <view class="card">
    <view class="section-title">商品列表</view>
    <view class="list-item" wx:for="{{products}}" wx:key="id">
      <view class="row space-between">
        <view style="flex: 1; padding-right: 16rpx;">
          <view>{{item.name}}</view>
          <view class="muted">{{item.description}}</view>
          <view class="muted">销量 {{item.soldCount}} · 库存 {{item.stock}}{{item.unit}}</view>
          <view class="price">{{item.price}} 元</view>
        </view>
        <view class="stepper">
          <view class="stepper-btn" data-product-id="{{item.id}}" data-quantity="{{item.inCart}}" data-delta="-1" bindtap="changeQuantity">-</view>
          <view>{{item.inCart}}</view>
          <view class="stepper-btn" data-product-id="{{item.id}}" data-quantity="{{item.inCart}}" data-delta="1" bindtap="changeQuantity">+</view>
        </view>
      </view>
    </view>
  </view>

  <view class="fixed-bottom row space-between">
    <view>
      <view>已选 {{cartSummary.totalCount}} 件</view>
      <view class="price">合计 {{cartSummary.totalAmount}} 元</view>
    </view>
    <button class="primary-btn" bindtap="goCart">去购物车</button>
  </view>
</view>
