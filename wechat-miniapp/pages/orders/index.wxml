<view class="page">
  <scroll-view scroll-x class="card" style="white-space: nowrap;">
    <view class="row">
      <view
        wx:for="{{tabs}}"
        wx:key="value"
        class="chip"
        style="{{activeStatus === item.value ? 'background:#7f5af0;color:#ffffff;' : ''}}"
        data-status="{{item.value}}"
        bindtap="selectTab"
      >
        {{item.label}}
      </view>
    </view>
  </scroll-view>

  <view class="card">
    <view wx:if="{{!orders.length}}" class="empty">暂无订单</view>
    <view wx:for="{{orders}}" wx:key="id" class="list-item">
      <view class="space-between">
        <view>
          <view style="font-weight:700;">订单号 {{item.orderNo}}</view>
          <view class="muted" style="margin-top: 6rpx;">{{item.createdAt}}</view>
        </view>
        <view class="pill-status {{item.status === 'refunded' || item.status === 'rejected' ? 'danger-status' : ''}}">{{item.statusLabel}}</view>
      </view>

      <view wx:for="{{item.items}}" wx:key="productId" class="list-item">
        <view class="space-between">
          <text>{{item.name}} x {{item.quantity}}</text>
          <text>¥{{item.price}}</text>
        </view>
      </view>

      <view class="space-between" style="margin-top: 12rpx;">
        <text class="muted">{{item.address.detail}}</text>
        <text class="price">¥{{item.totalAmount}}</text>
      </view>

      <view class="muted" style="margin-top: 10rpx;">最近进度：{{item.timeline[item.timeline.length - 1].text}}</view>

      <view class="action-row">
        <button wx:if="{{item.canPay}}" class="btn-light" data-id="{{item.id}}" bindtap="cancelUnpaid">取消</button>
        <button wx:if="{{item.canPay}}" class="btn-primary" data-id="{{item.id}}" bindtap="payOrder">去支付</button>
        <button wx:if="{{item.canRefund}}" class="btn-warn" data-id="{{item.id}}" bindtap="refundOrder">申请退款</button>
        <button wx:if="{{item.canComplete}}" class="btn-primary" data-id="{{item.id}}" bindtap="completeOrder">确认送达</button>
        <button wx:if="{{item.canReview}}" class="btn-light" data-id="{{item.id}}" bindtap="reviewOrder">去评价</button>
      </view>
    </view>
  </view>
</view>
