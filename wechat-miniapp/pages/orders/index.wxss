.filter-scroll {
  white-space: nowrap;
  margin-bottom: 24rpx;
}

.filter-row {
  display: inline-flex;
  gap: 12rpx;
}

.filter-item {
  padding: 14rpx 24rpx;
  border-radius: 999rpx;
  background: #edf1f7;
  color: #556178;
  font-size: 24rpx;
}

.filter-item.active {
  background: #fff1eb;
  color: #ff5a44;
}

.order-card {
  margin-bottom: 20rpx;
}

.order-head,
.action-row,
.timeline-item {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
}

.order-head {
  align-items: center;
  margin-bottom: 18rpx;
}

.merchant-name {
  font-size: 30rpx;
  font-weight: 700;
}

.status {
  font-size: 26rpx;
  font-weight: 700;
}

.order-item {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 0;
  border-top: 2rpx solid #f1f4fa;
  align-items: center;
}

.item-cover {
  width: 108rpx;
  height: 108rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
}

.item-content {
  flex: 1;
}

.item-name {
  font-size: 28rpx;
  font-weight: 600;
}

.item-price {
  color: #ff5a44;
  font-weight: 700;
}

.order-foot {
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 2rpx solid #f1f4fa;
}

.action-row {
  margin-top: 16rpx;
  flex-wrap: wrap;
}

.mini-action {
  font-size: 24rpx;
  line-height: 60rpx;
  padding: 0 24rpx;
}

.timeline {
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid #f1f4fa;
}

.timeline-title {
  margin-bottom: 8rpx;
}

.timeline-item {
  padding: 14rpx 0;
  align-items: flex-start;
}

.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #ff5a44;
  margin-top: 12rpx;
  flex-shrink: 0;
}

.timeline-content {
  flex: 1;
}

.refund-box {
  margin-top: 16rpx;
  padding: 18rpx;
  border-radius: 18rpx;
  background: #fff3f0;
  color: #cf1322;
}
