<view class="page">
  <view wx:if="{{!user}}" class="card empty">
    <view>登录后可查看地址、优惠券、余额和设置</view>
    <button class="primary-btn action-btn" bindtap="openLogin">去登录</button>
  </view>

  <block wx:elif="{{user}}">
    <view class="card profile-card">
      <view class="profile-head">
        <image class="avatar" src="{{user.avatarUrl}}" mode="aspectFill"></image>
        <view class="profile-meta">
          <view class="nickname">{{user.nickname}}</view>
          <view class="muted">{{user.phone || '微信授权用户'}}</view>
          <view class="tag role-tag">{{user.role === 'merchant' ? '商家账号' : '普通用户'}}</view>
        </view>
      </view>
      <view class="stat-grid">
        <view class="stat-item">
          <view class="stat-value">{{balanceDisplay}}</view>
          <view class="muted">余额</view>
        </view>
        <view class="stat-item">
          <view class="stat-value">{{couponCount}}</view>
          <view class="muted">优惠券</view>
        </view>
        <view class="stat-item">
          <view class="stat-value">{{addresses.length}}</view>
          <view class="muted">地址</view>
        </view>
      </view>
    </view>

    <view class="card section-card">
      <view class="section-title">地址管理</view>
      <view wx:if="{{addresses.length === 0}}" class="muted">暂无地址，点击下方按钮快速新增演示地址</view>
      <view wx:for="{{addresses}}" wx:key="id" class="address-item">
        <view class="address-main">
          <view class="address-head">
            <view class="address-name">{{item.name}} {{item.phone}}</view>
            <view class="tag">{{item.tag}}</view>
          </view>
          <view class="muted">{{item.city}} {{item.detail}}</view>
        </view>
        <view class="address-actions">
          <button class="ghost-btn mini-btn" data-id="{{item.id}}" bindtap="makeDefaultAddress">
            {{item.isDefault ? '默认地址' : '设为默认'}}
          </button>
          <button class="ghost-btn mini-btn" data-id="{{item.id}}" bindtap="removeAddress">删除</button>
        </view>
      </view>
      <button class="primary-btn action-btn" bindtap="addAddress">新增地址</button>
    </view>

    <view class="card section-card">
      <view class="section-title">优惠券</view>
      <view wx:if="{{couponSummary.length === 0}}" class="muted">暂无可用优惠券</view>
      <view wx:for="{{couponSummary}}" wx:key="id" class="coupon-item">
        <view class="coupon-left">
          <view class="coupon-amount">¥{{item.amount}}</view>
          <view class="muted">满 {{item.minSpend}} 可用</view>
        </view>
        <view class="coupon-right">
          <view class="coupon-title">{{item.title}}</view>
          <view class="muted">有效期至 {{item.expiresAt}}</view>
        </view>
      </view>
    </view>

    <view class="card section-card">
      <view class="section-title">客服与设置</view>
      <view class="setting-item">
        <view>客服电话</view>
        <view class="muted">{{customerService.phone}}</view>
      </view>
      <view class="setting-item">
        <view>客服微信</view>
        <view class="muted">{{customerService.wechat}}</view>
      </view>
      <view class="setting-item">
        <view>消息通知</view>
        <view class="muted">{{settings.notifications ? '已开启' : '已关闭'}}</view>
      </view>
      <view class="setting-item">
        <view>订单提醒</view>
        <view class="muted">{{settings.orderReminders ? '已开启' : '已关闭'}}</view>
      </view>
      <button class="ghost-btn action-btn" bindtap="openOrders">查看我的订单</button>
      <button wx:if="{{user.role === 'merchant'}}" class="ghost-btn action-btn" bindtap="openMerchantCenter">进入商家中心</button>
      <button class="ghost-btn action-btn" bindtap="logout">退出登录</button>
    </view>
  </block>
</view>
