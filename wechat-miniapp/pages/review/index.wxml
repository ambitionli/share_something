<view class="page">
  <view class="card">
    <view class="section-title">订单评价</view>
    <input class="input" type="digit" placeholder="星级评分 1-5" value="{{rating}}" bindinput="handleRatingInput" />
    <textarea class="textarea" placeholder="说说这次配送和商品体验" value="{{content}}" bindinput="handleContentInput"></textarea>
    <textarea class="textarea" placeholder="图片链接，每行一张（模拟上传）" value="{{imagesText}}" bindinput="handleImagesInput"></textarea>
    <button class="btn-primary" bindtap="submit">提交评价</button>
  </view>
</view>
