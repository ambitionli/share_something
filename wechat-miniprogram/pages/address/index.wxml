<view class="container">
  <view class="card form-card">
    <text class="section-title">新增 / 编辑地址</text>
    <view class="form-group"><text class="form-label">联系人</text><input class="form-input" data-key="contactName" value="{{form.contactName}}" bindinput="onInput" /></view>
    <view class="form-group"><text class="form-label">手机号</text><input class="form-input" type="number" maxlength="11" data-key="phone" value="{{form.phone}}" bindinput="onInput" /></view>
    <view class="form-group"><text class="form-label">详细地址</text><textarea class="form-textarea" data-key="detail" value="{{form.detail}}" bindinput="onInput"></textarea></view>
    <view class="form-group"><text class="form-label">标签</text><input class="form-input" data-key="tag" value="{{form.tag}}" bindinput="onInput" /></view>
    <checkbox-group bindchange="onDefaultChange"><label><checkbox checked="{{form.isDefault}}" value="default" />设为默认地址</label></checkbox-group>
    <button class="primary-btn" bindtap="save">保存地址</button>
  </view>

  <view class="list-gap">
    <view wx:for="{{addresses}}" wx:key="id" class="card address-card">
      <text class="address-name">{{item.contactName}} {{item.phone}}</text>
      <text class="address-detail">{{item.tag}} · {{item.detail}}</text>
      <view class="row action-row">
        <button size="mini" class="ghost-btn" data-id="{{item.id}}" bindtap="editAddress">编辑</button>
        <button size="mini" class="secondary-btn" data-id="{{item.id}}" bindtap="setDefault">设默认</button>
        <button size="mini" class="danger-btn" data-id="{{item.id}}" bindtap="removeAddress" disabled="{{item.deleteDisabled}}">删除</button>
        <button wx:if="{{item.canSelect}}" size="mini" class="primary-btn" data-id="{{item.id}}" bindtap="selectAddress">选择</button>
      </view>
    </view>
  </view>
</view>
