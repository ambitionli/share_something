.merchant-card,
.item-card {
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.merchant-name,
.item-name {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 10rpx;
}

.item-row {
  align-items: center;
}

.item-main {
  flex: 1;
}

.stepper {
  display: flex;
  align-items: center;
}

.count {
  margin: 0 18rpx;
  font-weight: 700;
}

.save-btn,
.empty-btn {
  margin-top: 20rpx;
}

.mr-12 {
  margin-right: 12rpx;
}
