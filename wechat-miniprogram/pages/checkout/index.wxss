.section-card {
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.selectable {
  border: 2rpx solid #e5e7eb;
}

.address-name {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.address-detail {
  display: block;
  color: #4b5563;
}

.order-item,
.money-row {
  margin-top: 16rpx;
}

.payment-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.payment-item {
  padding: 18rpx 20rpx;
  border-radius: 20rpx;
  background: #f3f4f6;
}

.payment-item-active {
  background: #dbeafe;
  color: #1d4ed8;
}

.total-row {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid #f3f4f6;
}
