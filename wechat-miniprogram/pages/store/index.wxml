<view class="container" wx:if="{{merchant}}">
  <view class="card header">
    <view class="row space-between">
      <view>
        <text class="name">{{merchant.name}}</text>
        <text class="subtle">评分 {{merchant.dynamicScore}} · {{merchant.reviewCount}} 条评价</text>
      </view>
      <view class="status-pill">{{merchant.avgDeliveryTime}}</view>
    </view>
    <text class="notice">{{merchant.notice}}</text>
    <view class="merchant-meta">
      <text class="chip">配送费 ￥{{merchant.deliveryFee}}</text>
      <text class="chip">起送 ￥{{merchant.minOrderAmount}}</text>
      <text class="chip">{{merchant.distance}}</text>
    </view>
  </view>

  <view class="section-title">商品列表</view>
  <view class="list-gap">
    <view wx:for="{{products}}" wx:key="id" class="card product-card">
      <view class="row space-between product-row">
        <view class="product-main">
          <text class="product-name">{{item.name}}</text>
          <text class="product-desc">{{item.description}}</text>
          <text class="product-extra">月售 {{item.sales}} · 库存 {{item.stock}}</text>
          <view class="row price-row">
            <text class="price">￥{{item.price}}</text>
            <text class="origin">￥{{item.originPrice}}</text>
          </view>
          <text class="current-count">已加购 {{item.cartQuantity}} {{item.unit}}</text>
        </view>
        <view class="stepper">
          <button size="mini" class="ghost-btn" data-product-id="{{item.id}}" data-delta="-1" bindtap="changeCount">-</button>
          <text class="count">{{item.cartQuantity}}</text>
          <button size="mini" class="secondary-btn" data-product-id="{{item.id}}" data-delta="1" bindtap="changeCount">+</button>
          <button size="mini" class="primary-btn buy-btn" data-id="{{item.id}}" bindtap="buyNow">立即购</button>
        </view>
      </view>
    </view>
  </view>

  <view class="section-title review-title">最近评价</view>
  <view class="list-gap">
    <block wx:if="{{reviews.length}}">
      <view wx:for="{{reviews}}" wx:key="id" class="card review-card">
        <view class="row space-between">
          <text class="review-name">{{item.nickname}}</text>
          <text class="status-pill">{{item.rating}} 星</text>
        </view>
        <text class="review-content">{{item.content}}</text>
      </view>
    </block>
    <view wx:else class="card empty-state">还没有评价，欢迎成为第一位评价用户。</view>
  </view>

  <view class="bottom-bar row space-between">
    <view>
      <text class="price">￥{{cartTotal}}</text>
      <text class="subtle"> 共 {{cartCount}} 件</text>
    </view>
    <button class="primary-btn" bindtap="goCart">查看购物车</button>
  </view>
</view>
